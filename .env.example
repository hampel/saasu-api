# Copy this file to .env beside the package. The rig loads it - unless an agent is running the
# command, in which case it deliberately does not; see harness/lib/harness.php.
#
# EVERY EXERCISE SPENDS THE FILE'S DAILY API QUOTA, and Saasu blocks a file's API access for 24
# hours once that is exceeded - for every integration using the file. Each run is capped at 60
# requests, and prints what it spent. Point this at a trial or demonstration file where you can.

# The Saasu file to work in - Settings, Web Services, or the scope of an OAuth grant.
SAASU_FILE_ID=

# EITHER a Saasu login, for OAuth - Saasu's preferred scheme. The login must not have two-factor
# authentication on, because nothing unattended can answer the code Saasu texts. A login
# created for the integration is better than a person's.
SAASU_USERNAME=
SAASU_PASSWORD=

# OR a web services access key, from Settings - Web Services. Used only when SAASU_USERNAME is
# empty. Saasu calls this scheme legacy, and the key travels in the URL of every request.
SAASU_WS_ACCESS_KEY=

# Optional. Set to exactly 1 to let the writing exercises write: contact-write, ledger-write,
# currency-write, workflows-write, roundtrip-write, permissions-write and sweep. contact-write
# creates, updates and deletes one throwaway contact; ledger-write seeds a whole small ledger -
# accounts, contacts, items, invoices, payments, a journal - and sweeps it away again. Anything
# else, including 0 and unset, reads and stops.
SAASU_WRITE=

# Required by every writing exercise but contact-write, which refuse to run unless this equals
# SAASU_FILE_ID. Set it to a file
# that exists to be written to and emptied - never one with real books in it. Its cleanup deletes
# every record whose name starts "ZZ", from any run.
SAASU_DISPOSABLE_FILE_ID=

# Optional. Where ledger-write sends the invoice emails it exercises - an address you control.
# Empty skips the email endpoints. ledger-write also gives its test customer this address, and
# Saasu emails whatever address a contact has.
SAASU_EMAIL_TO=

# Optional. A second login in the same file, whose user has restricted permissions - for
# permissions-write, which compares what it may read and write against the login above. Without
# it, that exercise stops before sending anything.
SAASU_RESTRICTED_USERNAME=
SAASU_RESTRICTED_PASSWORD=

# One more variable the harness reads is deliberately not listed above, because this file is
# meant to be copied to .env and it must never live in one:
#
#   SAASU_AGENT_MAY_WRITE=1      contact-write may write, in an agent session
#
# SAASU_WRITE is otherwise ignored when CLAUDECODE is set - it is read from a file written by
# whoever owns the login, which generally authorises the real thing, and an agent would inherit
# an authorisation nobody gave it. Put the override on the command line for one run.
